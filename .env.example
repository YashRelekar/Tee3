# =============================================================
#  T3 — Pi 4B Edition · API Keys
# =============================================================
#  Copy this file to .env and fill in your keys.
#
#    cp .env.example .env
#
#  All keys are OPTIONAL. T3 works without them, but you lose
#  the corresponding feature (see table below).
#
#  ┌────────────────────────┬────────────────────────────────┐
#  │ Variable               │ Feature unlocked               │
#  ├────────────────────────┼────────────────────────────────┤
#  │ OPENWEATHER_API_KEY    │ Live weather lookups           │
#  │ NEWSAPI_KEY            │ Top news headlines             │
#  │ MOONSHOT_API_KEY       │ Cloud AI answers (Kimi K2)     │
#  │                        │   — triggers when the local    │
#  │                        │     model signals cloud_handoff│
#  └────────────────────────┴────────────────────────────────┘
#
#  Cloud fallback (MOONSHOT_API_KEY)
#  ---------------------------------
#  The local qwen2.5:4b model routes complex / creative /
#  knowledge-heavy questions to cloud AI automatically.
#  Without this key T3 will say "cloud AI is not configured".
#  Get a free key at: https://platform.moonshot.ai/
#
#  Override the local model
#  ------------------------
#  CHAT_MODEL=phi3:mini   # or any Ollama model name
#
#  Microphone selection
#  --------------------
#  By default T3 auto-detects your USB mic using this priority:
#    1. MIC_NAME / AUDIO_INPUT_DEVICE env var (exact name substring)
#    2. mic_name key in config/config.json
#    3. Auto-detect: ReSpeaker / XVF3800 / seeed arrays
#    4. Auto-detect: legacy "USB PnP Sound Device"
#    5. Auto-detect: any other USB input device
#
#  Examples:
#    MIC_NAME=ReSpeaker           # matches any device whose name contains "ReSpeaker"
#    MIC_NAME=XVF3800             # matches ReSpeaker XVF3800 by model name
#    AUDIO_INPUT_DEVICE=USB Audio # alternative variable name (same priority)
#
#  To list all available input devices:
#    python3 -c "import sounddevice as sd; \
#      [print(i, d['name']) for i, d in enumerate(sd.query_devices()) \
#       if d['max_input_channels'] > 0]"
#  Or via ALSA: arecord -l
#
#  Start without a microphone (no wake word / voice input)
#  -------------------------------------------------------
#  DISABLE_AUDIO=1
#  This lets T3 start even when no mic is attached.  TTS output still works.
# =============================================================

OPENWEATHER_API_KEY=
NEWSAPI_KEY=
MOONSHOT_API_KEY=

# Optional: override local LLM (default: qwen2.5:4b)
# CHAT_MODEL=

# Optional: set microphone device (substring match against sounddevice name)
# MIC_NAME=
# AUDIO_INPUT_DEVICE=

# Optional: start without microphone / audio input (1 = disabled)
# DISABLE_AUDIO=
